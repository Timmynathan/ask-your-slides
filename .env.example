# Copy to .env (never commit .env). Phase in brackets = when it's first needed.

# [1] Supabase — Project Settings → API Keys / Connect
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # safe in the browser
SUPABASE_SECRET_KEY=sb_secret_...                         # server + ingestion only
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres   # Session pooler

# [2] Model providers
ANTHROPIC_API_KEY=            # chat + slide vision (Claude Haiku 5.5)
VOYAGE_API_KEY=               # embeddings (voyage-4, 1024 dims)

# [4] App settings
CHAT_MODEL=claude-haiku-5-5
DAILY_MESSAGE_CAP=50

# [3] Shown in the sign-in privacy notice as the address for deletion requests (optional)
NEXT_PUBLIC_PRIVACY_CONTACT=

# Who can open /admin (comma-separated PAU emails)
ADMIN_EMAILS=
