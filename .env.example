# Copy to .env (never commit .env). Phase in brackets = when it's first needed.

# [1] Supabase — Project Settings → API / Connect
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # publishable key; safe in the browser
SUPABASE_SERVICE_ROLE_KEY=    # secret key; server + ingestion only
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# [2] Model providers
ANTHROPIC_API_KEY=            # chat + slide vision (Claude Haiku 5.5)
OPENAI_API_KEY=               # embeddings only (text-embedding-3-small)

# [4] App settings
CHAT_MODEL=claude-haiku-5-5
DAILY_MESSAGE_CAP=50
